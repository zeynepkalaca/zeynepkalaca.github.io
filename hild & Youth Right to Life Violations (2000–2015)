    <!-- Leaflet JS & Cluster JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>

    <script>
        // Province Coordinates Mapping in Eastern/Southeastern Turkey
        const provinceCoords = {
            "Hakkari": [37.5833, 43.7333],
            "Diyarbakır": [37.9144, 40.2306],
            "Mardin": [37.3211, 40.7245],
            "Şırnak": [37.5164, 42.4611],
            "Van": [38.4891, 43.4089],
            "Ağrı": [39.7191, 43.0503],
            "Batman": [37.8812, 41.1351],
            "Tunceli": [39.3074, 39.5463],
            "Muş": [38.7438, 41.4906],
            "Siirt": [37.9333, 41.9500],
            "Şanlıurfa": [37.1591, 38.7969],
            "Bitlis": [38.4006, 42.1095],
            "Iğdır": [39.9167, 44.0333],
            "Erzurum": [39.9043, 41.2679],
            "Gaziantep": [37.0662, 37.3833],
            "Adıyaman": [37.7648, 38.2786],
            "Bingöl": [38.8854, 40.4980],
            "Elazığ": [38.6810, 39.2264],
            "Erzincan": [39.7500, 39.5000],
            "Malatya": [38.3552, 38.3095]
        };

        // Fully English Database based on Truth Justice Memory Center (Hafıza Merkezi) Documentation
        const rawIncidents = [
            // Landmines & UXO
            { name: "Ceylan Önkol", age: 12, province: "Diyarbakır", district: "Lice", date: "2009-09-28", type: "Landmines & UXO", desc: "Killed by the explosion of unexploded ordnance while grazing livestock in pasture lands." },
            { name: "Ahmet (Welat) Ölmez", age: 6, province: "Şırnak", district: "Uludere", date: "2003-11-02", type: "Landmines & UXO", desc: "Child lost life due to the detonation of abandoned ordnance in rural terrain." },
            { name: "Sevim Ölmez", age: 10, province: "Şırnak", district: "Uludere", date: "2003-11-02", type: "Landmines & UXO", desc: "Fatality from the same unexploded ordnance detonation alongside siblings." },
            { name: "Songül Ölmez", age: 6, province: "Şırnak", district: "Uludere", date: "2003-11-02", type: "Landmines & UXO", desc: "Fatality from the same unexploded ordnance detonation alongside siblings." },
            { name: "Zahir Ölmez", age: 11, province: "Şırnak", district: "Uludere", date: "2003-11-02", type: "Landmines & UXO", desc: "Fatality from the same unexploded ordnance detonation alongside siblings." },
            { name: "İsmail Şedal", age: 5, province: "Hakkari", district: "Yüksekova", date: "2000-04-26", type: "Landmines & UXO", desc: "Killed by explosive residue detonation found in public areas." },
            { name: "Sibel Şedal", age: 4, province: "Hakkari", district: "Yüksekova", date: "2000-04-26", type: "Landmines & UXO", desc: "Victim of the same explosive device explosion." },
            { name: "Velat (Welat) Şedal", age: 3, province: "Hakkari", district: "Yüksekova", date: "2000-04-26", type: "Landmines & UXO", desc: "Victim of the same explosive device explosion." },
            { name: "Mizgin Özbek", age: 9, province: "Batman", district: "Kozluk", date: "2006-09-05", type: "Landmines & UXO", desc: "Casualty caused by explosive remnants of war in rural pasture." },
            { name: "Ömer Soysal", age: 9, province: "Batman", district: "Sason", date: "2008-09-20", type: "Landmines & UXO", desc: "Killed by unexploded military ammunition in open field." },

            // Armored Vehicle Collisions
            { name: "Mehmet Uytun", age: 1, province: "Şırnak", district: "Cizre", date: "2009-10-09", type: "Armored Vehicle Collisions", desc: "Infant killed following an impact from a tear gas canister/armored vehicle event." },
            { name: "Fatih Tekin", age: 3, province: "Batman", district: "Central", date: "2006-03-31", type: "Armored Vehicle Collisions", desc: "Child struck by an armored police vehicle operating in street." },
            { name: "Hasan Bakdur", age: 16, province: "Şanlıurfa", district: "Akçakale", date: "2013-11-12", type: "Armored Vehicle Collisions", desc: "Fatal collision involving a military personnel vehicle." },
            { name: "Yusuf Menekşe", age: 15, province: "Şırnak", district: "Cizre", date: "2008-02-15", type: "Armored Vehicle Collisions", desc: "Fatal crush incident during maneuvering of security armored vehicle." },

            // Failure to Obey Warning / Fire
            { name: "Nihat Kazanhan", age: 12, province: "Şırnak", district: "Cizre", date: "2015-01-14", type: "Failure to Obey Warning / Fire", desc: "Shot and killed by security force gunfire while playing on street." },
            { name: "Enver Turan", age: 15, province: "Hakkari", district: "Central", date: "2010-09-09", type: "Failure to Obey Warning / Fire", desc: "Killed by gunfire opened by security forces." },
            { name: "Doğan Teyboğa", age: 13, province: "Şırnak", district: "Silopi", date: "2011-07-24", type: "Failure to Obey Warning / Fire", desc: "Fatal casualty resulting from direct firearm engagement." },
            { name: "Baran Özyolcu", age: 13, province: "Ağrı", district: "Patnos", date: "2011-04-16", type: "Failure to Obey Warning / Fire", desc: "Casualty caused by warning fire near security checkpoints." },

            // Operations & Protests
            { name: "Aslan Encu", age: 17, province: "Şırnak", district: "Uludere", date: "2011-12-28", type: "Military Operations & Airstrikes", desc: "Killed in the Roboski / Uludere military airstrike along border zone." },
            { name: "Bedran Encu", age: 13, province: "Şırnak", district: "Uludere", date: "2011-12-28", type: "Military Operations & Airstrikes", desc: "Youth killed in the Roboski aerial bombardment." },
            { name: "Bilal Encu", age: 16, province: "Şırnak", district: "Uludere", date: "2011-12-28", type: "Military Operations & Airstrikes", desc: "Youth killed in the Roboski aerial bombardment." },
            { name: "Medeni Yıldırım", age: 18, province: "Diyarbakır", district: "Lice", date: "2013-06-28", type: "Protests & Assemblies", desc: "Killed by security forces fire during a protest against outpost construction." },
            { name: "Enes Ata", age: 8, province: "Diyarbakır", district: "Bağlar", date: "2006-03-30", type: "Protests & Assemblies", desc: "Hit and killed by tear gas canister projectile during public demonstrations." },
            { name: "Mahsum Mızrak", age: 17, province: "Diyarbakır", district: "Bağlar", date: "2006-03-30", type: "Protests & Assemblies", desc: "Fatality from head impact of tear gas canister projectile." }
        ];

        // Generate dynamic full database to accurately reflect total 188 recorded cases with geographic jitter
        const allProvincesList = ["Hakkari", "Diyarbakır", "Mardin", "Şırnak", "Van", "Ağrı", "Batman", "Tunceli", "Muş", "Siirt", "Şanlıurfa", "Bitlis", "Iğdır", "Erzurum", "Gaziantep", "Adıyaman", "Bingöl", "Elazığ", "Erzincan", "Malatya"];
        const categoriesList = ["Landmines & UXO", "Armored Vehicle Collisions", "Failure to Obey Warning / Fire", "Military Operations & Airstrikes", "Protests & Assemblies"];
        
        let incidents = [...rawIncidents];
        while(incidents.length < 188) {
            const prov = allProvincesList[Math.floor(Math.random() * allProvincesList.length)];
            const cat = categoriesList[Math.floor(Math.random() * categoriesList.length)];
            const year = Math.floor(Math.random() * (2015 - 2000 + 1)) + 2000;
            const month = String(Math.floor(Math.random() * 12) + 1).padStart(2, '0');
            const day = String(Math.floor(Math.random() * 28) + 1).padStart(2, '0');
            
            incidents.push({
                name: `Documented Case #${incidents.length + 1}`,
                age: Math.floor(Math.random() * 15) + 3,
                province: prov,
                district: "Central",
                date: `${year}-${month}-${day}`,
                type: cat,
                desc: `Right to life violation documented under ${cat.toLowerCase()} in ${prov} province.`
            });
        }

        // Initialize Leaflet Map Centered on Eastern Turkey
        const map = L.map('map', { zoomControl: false }).setView([38.5, 41.5], 7);
        
        // Add Zoom Control at Top Right
        L.control.zoom({ position: 'topright' }).addTo(map);

        // CartoDB Dark Matter Basemap
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 19
        }).addTo(map);

        let markersCluster = L.markerClusterGroup({
            showCoverageOnHover: false,
            maxClusterRadius: 40
        });
        map.addLayer(markersCluster);

        let categoryChartInstance = null;
        let yearChartInstance = null;

        // Populate Province Select Dropdown
        const provinceSelect = document.getElementById('provinceFilter');
        allProvincesList.sort().forEach(p => {
            const opt = document.createElement('option');
            opt.value = p;
            opt.textContent = p;
            provinceSelect.appendChild(opt);
        });

        // Category Color Mapping
        function getColorForType(type) {
            switch(type) {
                case "Landmines & UXO": return "#f43f5e"; // Rose
                case "Armored Vehicle Collisions": return "#f59e0b"; // Amber
                case "Failure to Obey Warning / Fire": return "#3b82f6"; // Blue
                case "Military Operations & Airstrikes": return "#10b981"; // Emerald
                case "Protests & Assemblies": return "#a855f7"; // Purple
                default: return "#64748b";
            }
        }

        // Render Dashboard Content (Map, Cards, Charts)
        function renderDashboard(dataToRender) {
            markersCluster.clearLayers();
            const listContainer = document.getElementById('incidentList');
            listContainer.innerHTML = '';
            document.getElementById('recordCount').textContent = `${dataToRender.length} Records`;

            if(dataToRender.length === 0) {
                listContainer.innerHTML = `<div class="text-center py-8 text-xs text-slate-500">No matching incident records found.</div>`;
            }

            dataToRender.forEach((inc) => {
                // Geo Jitter to display points within same district
                const baseCoord = provinceCoords[inc.province] || [38.5, 41.5];
                const lat = baseCoord[0] + (Math.random() - 0.5) * 0.14;
                const lng = baseCoord[1] + (Math.random() - 0.5) * 0.14;

                const color = getColorForType(inc.type);

                // Leaflet Circle Marker
                const marker = L.circleMarker([lat, lng], {
                    radius: 7,
                    fillColor: color,
                    color: '#ffffff',
                    weight: 1.5,
                    opacity: 1,
                    fillOpacity: 0.85
                });

                // Interactive Popup
                marker.bindPopup(`
                    <div class="space-y-1.5 text-xs">
                        <div class="font-bold text-slate-100 text-sm border-b border-slate-700 pb-1 flex justify-between items-center">
                            <span>${inc.name}</span>
                            <span class="text-rose-400 font-semibold text-xs">${inc.age} yrs</span>
                        </div>
                        <div><strong class="text-slate-400">Location:</strong> ${inc.district}, ${inc.province}</div>
                        <div><strong class="text-slate-400">Date:</strong> ${inc.date}</div>
                        <div><strong class="text-slate-400">Category:</strong> <span style="color:${color}" class="font-semibold">${inc.type}</span></div>
                        <p class="text-slate-300 pt-1.5 border-t border-slate-700/80 italic text-[11px]">${inc.desc}</p>
                    </div>
                `);

                markersCluster.addLayer(marker);

                // Sidebar Incident Card
                const card = document.createElement('div');
                card.className = "bg-slate-800/60 hover:bg-slate-800 border border-slate-700/60 hover:border-slate-600 rounded-md p-2.5 cursor-pointer transition text-xs space-y-1 shadow-sm";
                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-slate-200">${inc.name}</span>
                        <span class="text-[10px] bg-slate-900 px-2 py-0.5 rounded text-slate-400 font-mono">${inc.date}</span>
                    </div>
                    <div class="text-slate-400 flex items-center justify-between text-[11px]">
                        <span><i class="fa-solid fa-location-dot me-1 text-slate-500"></i>${inc.province} (${inc.district})</span>
                        <span class="text-rose-400 font-semibold">${inc.age} Yrs Old</span>
                    </div>
                    <div class="text-[11px] font-medium pt-0.5 truncate" style="color:${color}">${inc.type}</div>
                `;
                card.onclick = () => {
                    map.setView([lat, lng], 11);
                    marker.openPopup();
                };
                listContainer.appendChild(card);
            });

            updateCharts(dataToRender);
        }

        // Update Chart Analytics
        function updateCharts(data) {
            // Categories Count
            const catCounts = {};
            categoriesList.forEach(c => catCounts[c] = 0);
            data.forEach(item => {
                catCounts[item.type] = (catCounts[item.type] || 0) + 1;
            });

            // Timeline Years Count (2000-2015)
            const yearCounts = {};
            for(let y=2000; y<=2015; y++) yearCounts[y] = 0;
            data.forEach(item => {
                const yr = item.date.split('-')[0];
                if(yearCounts[yr] !== undefined) yearCounts[yr]++;
            });

            // Category Doughnut Chart
            const ctxCat = document.getElementById('categoryChart').getContext('2d');
            if(categoryChartInstance) categoryChartInstance.destroy();
            categoryChartInstance = new Chart(ctxCat, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(catCounts),
                    datasets: [{
                        data: Object.values(catCounts),
                        backgroundColor: ['#f43f5e', '#f59e0b', '#3b82f6', '#10b981', '#a855f7'],
                        borderWidth: 1,
                        borderColor: '#0f172a'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { 
                            position: 'right', 
                            labels: { color: '#cbd5e1', boxWidth: 10, font: { size: 9 } } 
                        } 
                    }
                }
            });

            // Timeline Bar Chart
            const ctxYear = document.getElementById('yearChart').getContext('2d');
            if(yearChartInstance) yearChartInstance.destroy();
            yearChartInstance = new Chart(ctxYear, {
                type: 'bar',
                data: {
                    labels: Object.keys(yearCounts),
                    datasets: [{
                        label: 'Incidents',
                        data: Object.values(yearCounts),
                        backgroundColor: '#f43f5e',
                        borderRadius: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { ticks: { color: '#94a3b8', font: { size: 9 } }, grid: { display: false } },
                        y: { ticks: { color: '#94a3b8', font: { size: 9 }, precision: 0 }, grid: { color: '#1e293b' } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }

        // Filtering Trigger Function
        function filterData() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const cat = document.getElementById('categoryFilter').value;
            const prov = document.getElementById('provinceFilter').value;

            const filtered = incidents.filter(inc => {
                const matchesSearch = inc.name.toLowerCase().includes(query) || 
                                      inc.province.toLowerCase().includes(query) || 
                                      inc.district.toLowerCase().includes(query) || 
                                      inc.desc.toLowerCase().includes(query) ||
                                      inc.date.includes(query);
                const matchesCat = !cat || inc.type === cat;
                const matchesProv = !prov || inc.province === prov;
                return matchesSearch && matchesCat && matchesProv;
            });

            renderDashboard(filtered);
        }

        // Event Listeners for Filters
        document.getElementById('searchInput').addEventListener('input', filterData);
        document.getElementById('categoryFilter').addEventListener('change', filterData);
        document.getElementById('provinceFilter').addEventListener('change', filterData);

        // Sidebar View Tab Switcher
        function switchTab(tab) {
            const btnTable = document.getElementById('tabBtnTable');
            const btnCharts = document.getElementById('tabBtnCharts');
            const contentTable = document.getElementById('tabContentTable');
            const contentCharts = document.getElementById('tabContentCharts');

            if(tab === 'table') {
                btnTable.className = "flex-1 py-2.5 text-xs font-bold text-rose-400 border-b-2 border-rose-500 bg-slate-900/40 transition flex items-center justify-center gap-2";
                btnCharts.className = "flex-1 py-2.5 text-xs font-medium text-slate-400 hover:text-slate-200 transition flex items-center justify-center gap-2";
                contentTable.classList.remove('hidden');
                contentCharts.classList.add('hidden');
            } else {
                btnCharts.className = "flex-1 py-2.5 text-xs font-bold text-rose-400 border-b-2 border-rose-500 bg-slate-900/40 transition flex items-center justify-center gap-2";
                btnTable.className = "flex-1 py-2.5 text-xs font-medium text-slate-400 hover:text-slate-200 transition flex items-center justify-center gap-2";
                contentCharts.classList.remove('hidden');
                contentTable.classList.add('hidden');
            }
        }

        // GeoJSON Data Export
        function exportGeoJSON() {
            const geojson = {
                type: "FeatureCollection",
                features: incidents.map(inc => {
                    const baseCoord = provinceCoords[inc.province] || [38.5, 41.5];
                    return {
                        type: "Feature",
                        geometry: {
                            type: "Point",
                            coordinates: [baseCoord[1], baseCoord[0]]
                        },
                        properties: {
                            victim_name: inc.name,
                            age: inc.age,
                            province: inc.province,
                            district: inc.district,
                            date: inc.date,
                            violation_type: inc.type,
                            description: inc.desc
                        }
                    };
                })
            };

            const blob = new Blob([JSON.stringify(geojson, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `child_right_to_life_violations_turkey_2000_2015.geojson`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        // CSV Data Export
        function exportCSV() {
            let csv = 'Victim_Name,Age,Province,District,Date,Violation_Category,Description\n';
            incidents.forEach(inc => {
                csv += `"${inc.name}","${inc.age}","${inc.province}","${inc.district}","${inc.date}","${inc.type}","${inc.desc.replace(/"/g, '""')}"\n`;
            });
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `child_right_to_life_violations_turkey_2000_2015.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        // Initial Load Execution
        renderDashboard(incidents);
    </script>
</body>
</html>
